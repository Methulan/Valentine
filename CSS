body {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: pink;
    font-family: 'Arial', sans-serif;
    text-align: center;
}

.container {
    text-align: center;
}

#heart {
    font-size: 100px;
    cursor: pointer;
    color: red;
    animation: heartbeat 1.5s infinite;
}

@keyframes heartbeat {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

.hidden {
    display: none;
}

#images img {
    width: 200px;
    margin: 10px;
    border-radius: 10px;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.2);
}

#poem {
    margin-top: 20px;
    font-size: 20px;
    color: darkred;
    font-weight: bold;
}